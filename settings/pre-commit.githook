#!/bin/sh
# Installed by claude-belay (install.sh --git-hook).
#
# belay's gates are AGENT gates: pre-commit-security.sh runs as a PreToolUse
# hook, so it only ever sees Bash commands the agent runs. A person typing
# `git commit` in a terminal is not covered by any of it. This hook feeds the
# same script the payload Claude Code would have sent, so both paths hit one
# scanner, one allowlist, one set of patterns.
#
# Disable: delete this file. Skip once: git commit --no-verify.
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
# Fails open when belay is gone: an uninstall must not brick every commit.
[ -x "$root/.claude/hooks/pre-commit-security.sh" ] || exit 0
echo '{"tool_name":"Bash","tool_input":{"command":"git commit"}}' \
  | CLAUDE_PROJECT_DIR="$root" "$root/.claude/hooks/pre-commit-security.sh"
