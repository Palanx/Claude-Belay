#!/bin/sh
# Installed by claude-belay (install.sh --git-hook).
#
# belay's gates are AGENT gates: they fire on the agent's tool calls and never
# see a person typing `git commit`. This hook runs the same gates over the
# staged files, so both paths hit one set of checks.
#
# A locator, not logic: everything it runs is package-owned and upgrades with a
# normal re-install. .git/hooks/ is written once by the installer and never
# managed again, so logic placed here could only be upgraded by hand.
#
# Disable: delete this file. Skip once: git commit --no-verify.
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
# Fails open when belay is gone: an uninstall must not brick every commit. Test
# the library, not check.sh — check.sh lives outside .claude/ and survives a
# `rm -rf .claude`, at which point it exits 1 and would block every commit.
[ -f "$root/.claude/hooks/lib/common.sh" ] || exit 0
for c in "$root/.belay/scripts/check.sh" "$root/scripts/check.sh"; do
  [ -x "$c" ] && exec "$c" --staged
done
exit 0
